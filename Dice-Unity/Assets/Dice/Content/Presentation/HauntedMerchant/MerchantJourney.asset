      data:
        title: The Merchant
        text: Looking for someone? Yes, they passed this way. Left the road and went into the marsh.
        continueLabel: Ask about the path
        duration: 3
        hostState: 2
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
