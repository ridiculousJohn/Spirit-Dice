    - rid: 1123138610053513254
      type: {class: InvitationBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: The Unquiet Cart
        text: It is already listening. Accept, and we begin.
        continueLabel: Accept the bargain
