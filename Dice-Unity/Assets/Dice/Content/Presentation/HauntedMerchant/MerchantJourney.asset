    - rid: 1123138610053513248
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: The path they took
        text: I know the path they took. But I can't leave my wares with this thing awake.
        continueLabel: Ask what is awake
        duration: 0
        hostState: 0
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
        scene: {fileID: 0}
        transition: 0
