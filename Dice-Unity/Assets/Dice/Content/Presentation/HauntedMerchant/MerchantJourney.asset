    - rid: 1123138610053513252
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: The Merchant's Candle
        text: This keeps its fingers off things. Set it beside what you want left alone.
        continueLabel: Ask about the charms
        duration: 0
        hostState: 0
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
