    - rid: 1123138610053513253
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: What the wares reveal
        text: 'This bargain reveals Draining Bowl, Returning Echo, and Counted Coins. Their charms reward a trader''s habits: careful counting and repeating what worked.'
        continueLabel: Hear the terms
        duration: 0
        hostState: 0
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
        scene: {fileID: 0}
        transition: 0
