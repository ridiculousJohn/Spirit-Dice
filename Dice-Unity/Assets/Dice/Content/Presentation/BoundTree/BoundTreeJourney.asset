      data:
        title: At the roots
        text: At the base of the tree a young woman sits with her knees drawn up, weeping. Her skin is the grey of old bark.
        continueLabel: Kneel beside her
        duration: 0
        hostState: 1
        audioCue: {fileID: 8300000, guid: b7b9cd953c78406e80bdf0766d05a80f, type: 3}
        progressionReward: {fileID: 0}
