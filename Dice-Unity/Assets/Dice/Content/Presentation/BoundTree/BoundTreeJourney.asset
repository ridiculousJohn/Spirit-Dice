    - rid: 1123138610053513261
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: Above her
        text: The tree creaks above her.
        continueLabel: Ask what holds her
        duration: 0
        hostState: 1
