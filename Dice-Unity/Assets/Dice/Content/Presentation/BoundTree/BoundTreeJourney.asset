    - rid: 1123138610053513262
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: When the water rose
        text: Something crept into my tree when the water rose. It holds me the way it holds the roots.
        continueLabel: Ask about the traveler
        duration: 0
        hostState: 1
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
        scene: {fileID: 0}
        transition: 0
