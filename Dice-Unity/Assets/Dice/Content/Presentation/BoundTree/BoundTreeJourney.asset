      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: What the roots reveal
        text: 'This challenge reveals Great Oak, Close Branches, and Unturned Leaf. Their charms reward a rooted hand: one great die, close neighbors, and leaves left unturned.'
        continueLabel: Hear the terms
        duration: 0
        hostState: 0
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
        scene: {fileID: 0}
