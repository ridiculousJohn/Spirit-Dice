    - rid: 1123138610053513260
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: The Nymph
        text: You shouldn't be here. It hears everything.
        continueLabel: Stay beside her
        duration: 0
        hostState: 1
        audioCue: {fileID: 0}
