    - rid: 1123138610053513263
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: Where they went
        text: Your traveler came this way. I saw where they went, but it won't let me speak of it.
        continueLabel: Ask how to free her
        duration: 0
        hostState: 1
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
        scene: {fileID: 0}
        transition: 0
