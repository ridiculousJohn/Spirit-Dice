    - rid: 1123138610053513264
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: Barely a whisper
        text: It is bound by the old terms. Challenge it, and it must play, and it must honor the result.
        continueLabel: Challenge the spirit
        duration: 0
        hostState: 1
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
