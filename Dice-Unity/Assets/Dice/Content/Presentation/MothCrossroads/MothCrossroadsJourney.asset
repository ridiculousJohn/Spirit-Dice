    - rid: 1123138610053513233
      type: {class: DialogueBeat, ns: Dice.Presentation, asm: Dice.Presentation}
      data:
        title: Around the flame
        text: Small moths dart around the lantern. One leaves the light, doubles back, and turns toward the cart.
        continueLabel: Follow its movement
        duration: 0
        hostState: 1
        audioCue: {fileID: 0}
        progressionReward: {fileID: 0}
