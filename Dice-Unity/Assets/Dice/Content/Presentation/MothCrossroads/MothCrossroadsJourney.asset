  - id: witness
    kind: 2
    title: The Lightkeeper
    text: Your traveler came through here. The blue light waited at the old crossing. I went close enough to hear them speak.
    continueLabel: Ask which road
    background: {fileID: 0}
    sceneLighting: {fileID: 0}
    foreground: {fileID: 0}
    audioCue: {fileID: 0}
    duration: 0
