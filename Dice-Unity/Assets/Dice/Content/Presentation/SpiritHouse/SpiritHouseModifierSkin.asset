  effectWording:
  - kind: 0
    singularLabel: base score
    pluralLabel: base score
    compactLabel: B
  - kind: 1
    singularLabel: multiplier
    pluralLabel: multiplier
    compactLabel: M
  - kind: 2
    singularLabel: reroll
    pluralLabel: rerolls
    compactLabel: R
  noEffectsText: No effects
  phaseWording:
  - phase: 0
    timingLabel: On the initial roll
    descriptionLead: On initial roll
    impliedLimits: 
  - phase: 1
    timingLabel: After a reroll
    descriptionLead: When rerolling
    impliedLimits: 
  - phase: 2
    timingLabel: When your hand is scored
    descriptionLead: When playing a hand
    impliedLimits: 01000000i
  limitWording:
  - limit: 0
    timingLabel: Every time
    descriptionNote: 
  - limit: 1
    timingLabel: Once per hand
    descriptionNote: Once per hand.
  - limit: 2
    timingLabel: Once per stage
    descriptionNote: Once per stage.
  contributionWording:
    baseScoreLabel: base
    multiplierLabel: mult
    rerollLabel: reroll
    rerollsLabel: rerolls
  textFormat:
    effect: +{amount} {label}
    effectSeparator: ', '
    compactEffect: +{amount}
    labeledCompactEffect: +{amount} {label}
    compactEffectSeparator: '

'
    timing: '{phase} / {limit}'
    contribution: +{amount} {label}
    contributionSeparator: '  /  '
