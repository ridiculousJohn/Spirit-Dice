  m_Script: {fileID: 11500000, guid: 13a2179ce2ab44a59ab59de3267cba11, type: 3}
  m_Name: LastLanternJourney
  m_EditorClassIdentifier: 
  encounterId: encounter.fox.introduction
  locationTitle: The Last Lantern
  spiritName: The Lantern Keeper
  leadText: A missing traveler was last seen following a lantern through the rain. The light is still burning.
  cardArtwork: {fileID: 2800000, guid: 74eb1ce65d124aa9823839f4404df805, type: 3}
  beats:
  - id: approach
    kind: 0
    title: A light in the rain
    text: The trail ends at a quiet doorway. Behind the paper, a shadow turns before anyone moves.
    continueLabel: Approach the door
    background: {fileID: 2800000, guid: 74eb1ce65d124aa9823839f4404df805, type: 3}
    foreground: {fileID: 2800000, guid: 8ae3013c2027a8f468aa392a983c3918, type: 3}
    duration: 6
    motionFrom: {x: -0.06, y: 0}
    motionTo: {x: 0.05, y: 0.015}
    foregroundRect: {serializedVersion: 2, x: 0.22, y: 0.52, width: 0.40, height: 0.28}
    foregroundTint: {r: 0.04, g: 0.025, b: 0.02, a: 0.36}
    transition: 0
    scaleFrom: 0.72
    scaleTo: 0.8
  - id: arrival
    kind: 1
    title: An unexpected welcome
    text: The doors part. A place has already been set for you.
    continueLabel: Take a seat
    background: {fileID: 0}
    foreground: {fileID: 0}
    duration: 2
    motionFrom: {x: 0, y: 0}
    motionTo: {x: 0, y: 0}
    foregroundRect: {serializedVersion: 2, x: 0, y: 0, width: 1, height: 1}
    foregroundTint: {r: 1, g: 1, b: 1, a: 1}
    transition: 1
    scaleFrom: 1
    scaleTo: 1
  - id: bargain
    kind: 2
    title: The Lantern Keeper
    text: They sheltered here. I remember where they went. Win, and I will tell you.
    continueLabel: Hear the terms
    background: {fileID: 0}
    foreground: {fileID: 0}
    duration: 5
    motionFrom: {x: 0, y: 0}
    motionTo: {x: 0, y: 0}
    foregroundRect: {serializedVersion: 2, x: 0, y: 0, width: 1, height: 1}
    foregroundTint: {r: 1, g: 1, b: 1, a: 1}
    transition: 0
    scaleFrom: 1
    scaleTo: 1
  - id: invitation
    kind: 3
    title: The Host's Courtesy
    text: Your first mistake costs you nothing.
    continueLabel: Accept the bargain
    background: {fileID: 0}
    foreground: {fileID: 0}
    duration: 2
    motionFrom: {x: 0, y: 0}
    motionTo: {x: 0, y: 0}
    foregroundRect: {serializedVersion: 2, x: 0, y: 0, width: 1, height: 1}
    foregroundTint: {r: 1, g: 1, b: 1, a: 1}
    transition: 0
    scaleFrom: 1
    scaleTo: 1
  tablePresentation: {fileID: 11400000, guid: 74eb1ce65d124aa9823839f4404df802, type: 2}
  victoryTitle: A promise kept
  victoryText: You have earned an answer. They left before dawn, following the river upstream. Listen where the water falls silent.
  defeatTitle: The lantern is still burning
  defeatText: Not tonight. The road will wait, and so will I. Come back when you are ready to try again.
  abandonText: The keeper leaves your place at the table open.
  resultContinueLabel: Return to the trail
  completionClueTitle: Where the water falls silent
  completionClueText: The missing traveler followed the river upstream before dawn. Search for a place where the water makes no sound.
