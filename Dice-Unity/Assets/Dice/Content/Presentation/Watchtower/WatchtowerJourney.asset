  encounterId: encounter.owl.watchtower
  locationTitle: The Watchtower
  spiritName: The Watcher
  leadText: The fox saw the missing traveler cross the marsh toward the old watchtower. A watcher waits above the steps.
  cardArtwork: {fileID: 2800000, guid: 85a75b59e31c4b169bddb725c4401001, type: 3}
  beats:
  - id: approach
    kind: 0
    title: The Watchtower
    text: The fox's directions end at a stairway above the marsh. A small lantern still burns beside the open arch.
    continueLabel: Climb the steps
