# Normalize text in Git; Unity YAML and source files remain readable and diffable.
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text=auto eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.scenetemplate text eol=lf
*.terrainlayer text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Images, models, audio, video, fonts, and other binary assets use Git LFS.
